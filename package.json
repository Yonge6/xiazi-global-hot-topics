{
  "name": "xiazi-global-hot-topics",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:e2e:staging": "npm run test:e2e:staging -w @xiazi/web",
    "content:import": "tsx scripts/import-content-to-supabase.ts",
    "content:verify": "tsx scripts/verify-supabase-content.ts",
    "content:compare": "tsx scripts/compare-content-sources.ts",
    "audit:config": "turbo audit:config",
    "audit:storage-policy": "node scripts/audit-storage-policy.mjs",
    "storage:verify:staging": "node scripts/verify-storage-immutability.mjs",
    "staging:guard:test": "node --test scripts/tests/staging-rehearsal.test.mjs",
    "staging:verify": "node scripts/verify-release-v2-staging.mjs",
    "staging:prepare-release": "tsx scripts/prepare-staging-release.ts",
    "staging:stage-release": "node scripts/stage-staging-release.mjs",
    "staging:publication-rpc": "node scripts/staging-publication-rpc.mjs",
    "staging:faults:reviewer": "node scripts/staging-reviewer-faults.mjs",
    "staging:faults:source": "tsx scripts/staging-source-faults.ts",
    "staging:faults:visual": "tsx scripts/staging-visual-faults.ts",
    "staging:faults:database": "node scripts/staging-database-faults.mjs",
    "staging:faults:storage": "tsx scripts/staging-storage-faults.ts",
    "staging:faults:degraded": "node scripts/staging-degraded-fallback.mjs",
    "staging:evidence:lifecycle": "node scripts/staging-lifecycle-evidence.mjs",
    "check": "turbo check && node --test scripts/tests/local-poster-retention.test.mjs scripts/tests/archive-issue-consistency.test.mjs scripts/tests/remote-file-fetch.test.mjs scripts/tests/publish-current-release-manifest.test.mjs",
    "posters:cleanup:local": "node scripts/cleanup-local-poster-cache.mjs --retain 3 --apply",
    "posters:cleanup:preview": "node scripts/cleanup-local-poster-cache.mjs --retain 3",
    "publication:preflight": "tsx scripts/preflight-daily-publication.ts",
    "posters:verify:remote": "node scripts/verify-daily-release.mjs --remote-archive --today",
    "web:dev": "npm run dev -w @xiazi/web",
    "posters:default": "npm run posters:default -w @xiazi/web"
  },
  "devDependencies": {
    "supabase": "^2.107.0",
    "tsx": "^4.22.4",
    "turbo": "^2.6.1"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2"
  }
}
