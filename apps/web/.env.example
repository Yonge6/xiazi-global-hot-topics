NEXT_PUBLIC_SITE_URL=https://xiazishuo.com
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN
PUBLICATION_TIMEZONE=Asia/Shanghai
PUBLICATION_HOUR=5
PUBLICATION_MINUTE=0

STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=
GITHUB_STUDIO_TOKEN=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
NEXT_PUBLIC_COS_BASE_URL=
# Future Release V2 uses a dedicated Xiazi staging COS bucket that has never
# enabled versioning. These attestations stay false until the protected cloud
# verifier proves the applied policy; false/missing values block staging.
COS_IMMUTABLE_VERSIONING_STATE=unknown
RELEASE_ASSET_ORIGINS=
RELEASE_STORAGE_POLICY_VERSION=xiazi-cos-immutable-v1
RELEASE_STORAGE_POLICY_VERIFIED=false
RELEASE_STORAGE_POLICY_VERIFIED_AT=
RELEASE_STORAGE_VERIFICATION_TOOL_VERSION=xiazi-storage-verifier-v1
RELEASE_STORAGE_OVERWRITE_DENIED=false
RELEASE_STORAGE_DELETE_DENIED=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred server-side Supabase keys. Preview defaults to JSON and should not
# contain the Production secret. Production uses these only for shadow compare
# while CONTENT_REPOSITORY remains json.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CONTENT_REPOSITORY=json
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ENV=local
# Phase 4B safety switch. Default false means Studio keeps GitHub JSON as the
# only write path. Set true only after migrations and closed-state deployment
# checks pass. This is server-only; never use NEXT_PUBLIC_.
STUDIO_SHADOW_WRITE_ENABLED=false
# Set to true only in Vercel Production Phase 4A shadow reads.
SHADOW_COMPARE_ENABLED=false
SHADOW_COMPARE_SECRET=
# Optional protected read-only observer for recent Publish Run status.
PUBLISH_RUN_STATUS_SECRET=

OPENAI_API_KEY=
RESEARCH_TEXT_MODEL=gpt-5.4-mini
TRANSLATION_MODEL=gpt-5.4-mini
POSTER_IMAGE_PROVIDER=openai
POSTER_IMAGE_MODEL=gpt-image-2
POSTER_IMAGE_QUALITY=high
POSTER_IMAGE_SIZE=1920x3840
POSTER_IMAGE_FORMAT=png

CRON_SECRET=
ISSUE_CRON_UTC=0 21 * * *
AUTO_GENERATE_POSTERS=false
AUTO_PUBLISH=true
MAX_IMAGE_GENERATIONS_PER_DAY=18

# Future Release V2 reviewer client. Server-only and staging-first.
SOURCE_SEMANTIC_REVIEW_URL=
POSTER_VISION_REVIEW_URL=
RELEASE_REVIEW_BEARER_SECRET=
RELEASE_REVIEW_SIGNING_SECRET=
RELEASE_REVIEW_TIMEOUT_MS=45000

# Isolated Release V2 staging only. Never copy these switches into the current
# production project until the final production-enablement review passes.
RELEASE_ENVIRONMENT=local
RELEASE_V2_ENABLED=false
RELEASE_EXPLICIT_DEGRADED_FALLBACK=false
