{
  "version": "2.0",
  "statement": [
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${READER_UIN}",
          "qcs::cam::uin/${OWNER_UIN}:service/cdn"
        ]
      },
      "effect": "allow",
      "action": [
        "name/cos:GetObject",
        "name/cos:HeadObject",
        "name/cos:OptionsObject"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/release-assets/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "true"
        }
      }
    }
  ]
}
