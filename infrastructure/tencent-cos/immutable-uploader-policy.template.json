{
  "version": "2.0",
  "statement": [
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${UPLOADER_UIN}"
        ]
      },
      "effect": "allow",
      "action": [
        "name/cos:PutObject"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/release-assets/*"
      ],
      "condition": {
        "string_equal": {
          "cos:x-cos-forbid-overwrite": "true",
          "cos:content-type": "image/png"
        },
        "bool_equal": {
          "cos:secure-transport": "true"
        }
      }
    },
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${UPLOADER_UIN}"
        ]
      },
      "effect": "deny",
      "action": [
        "name/cos:PutObject"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/release-assets/*"
      ],
      "condition": {
        "string_not_equal_if_exist": {
          "cos:x-cos-forbid-overwrite": "true"
        }
      }
    },
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${UPLOADER_UIN}"
        ]
      },
      "effect": "allow",
      "action": [
        "name/cos:GetObject"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/release-assets/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "true"
        }
      }
    },
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${UPLOADER_UIN}"
        ]
      },
      "effect": "deny",
      "action": [
        "name/cos:DeleteObject",
        "name/cos:DeleteMultipleObjects",
        "name/cos:PutObjectACL",
        "name/cos:PutObjectTagging",
        "name/cos:DeleteObjectTagging",
        "name/cos:InitiateMultipartUpload",
        "name/cos:UploadPart",
        "name/cos:CompleteMultipartUpload",
        "name/cos:AbortMultipartUpload",
        "name/cos:UploadPartCopy",
        "name/cos:PutObjectCopy",
        "name/cos:PostObject",
        "name/cos:AppendObject",
        "name/cos:PutObjectRetention"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/release-assets/*"
      ]
    },
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${UPLOADER_UIN}"
        ]
      },
      "effect": "deny",
      "action": [
        "name/cos:PutBucketPolicy",
        "name/cos:PutBucketVersioning",
        "name/cos:PutBucketObjectLockConfiguration",
        "name/cos:PutBucketEncryption",
        "name/cos:DeleteBucketEncryption",
        "name/cos:PutBucketLifecycle",
        "name/cos:PutBucketReplication"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/*"
      ]
    }
  ]
}
