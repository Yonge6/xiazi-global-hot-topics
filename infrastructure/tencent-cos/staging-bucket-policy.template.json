{
  "version": "2.0",
  "statement": [
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${UPLOADER_UIN}"
        ]
      },
      "effect": "allow",
      "action": [
        "name/cos:PutObject"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/release-assets/*"
      ],
      "condition": {
        "string_equal": {
          "cos:x-cos-forbid-overwrite": "true",
          "cos:content-type": "image/png"
        },
        "bool_equal": {
          "cos:secure-transport": "true"
        }
      }
    },
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${UPLOADER_UIN}"
        ]
      },
      "effect": "deny",
      "action": [
        "name/cos:PutObject"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/release-assets/*"
      ],
      "condition": {
        "string_not_equal_if_exist": {
          "cos:x-cos-forbid-overwrite": "true"
        }
      }
    },
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${UPLOADER_UIN}"
        ]
      },
      "effect": "allow",
      "action": [
        "name/cos:GetObject"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/release-assets/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "true"
        }
      }
    },
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${AUDITOR_UIN}"
        ]
      },
      "effect": "allow",
      "action": [
        "name/cos:GetBucketVersioning",
        "name/cos:GetBucketPolicy",
        "name/cos:GetBucketEncryption"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "true"
        }
      }
    },
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${AUDITOR_UIN}"
        ]
      },
      "effect": "allow",
      "action": [
        "name/cos:GetObject"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/release-assets/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "true"
        }
      }
    },
    {
      "principal": {
        "qcs": [
          "qcs::cam::uin/${OWNER_UIN}:uin/${CDN_READER_UIN}"
        ]
      },
      "effect": "allow",
      "action": [
        "name/cos:GetObject"
      ],
      "resource": [
        "qcs::cos:${COS_REGION}:uid/${APP_ID}:${STAGING_BUCKET}/release-assets/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "true"
        }
      }
    }
  ]
}
